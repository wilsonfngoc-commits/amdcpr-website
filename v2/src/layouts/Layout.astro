---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title = 'AMD 預設醫療指示 — 上門簽署 | DoctorNow', description = '上門簽署 AMD｜Home-Visit AMD Signing', ogImage = 'https://dnacpr.hk/og-image.png' } = Astro.props;
const lang = Astro.params.lang || 'zh';
const isZh = lang === 'zh';
const currentPath = Astro.url.pathname;

const pathWithoutLang = currentPath.replace(/^\/(zh|en)/, '') || '/';
const zhPath = `/zh${pathWithoutLang === '/' ? '/' : pathWithoutLang}`;
const enPath = `/en${pathWithoutLang === '/' ? '/' : pathWithoutLang}`;
const canonicalURL = Astro.site
  ? new URL(currentPath, Astro.site)
  : new URL(currentPath, Astro.url.origin);
const zhURL = Astro.site ? new URL(zhPath, Astro.site) : new URL(zhPath, Astro.url.origin);
const enURL = Astro.site ? new URL(enPath, Astro.site) : new URL(enPath, Astro.url.origin);
const ogLocale = isZh ? 'zh_HK' : 'en_US';
const ogLocaleAlt = isZh ? 'en_US' : 'zh_HK';
---

<!doctype html>
<html lang={isZh ? 'zh-HK' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang="zh-HK" href={zhURL.href} />
    <link rel="alternate" hreflang="en" href={enURL.href} />
    <link rel="alternate" hreflang="x-default" href={zhURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta property="og:site_name" content="DoctorNow AMD" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- Meta Pixel Code (canonical BM pixel 4144712838891867 — one-pixel design 2026-09-05, eventID prefix dnacpr_) -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '4144712838891867');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=4144712838891867&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H6QSG5KYZ3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H6QSG5KYZ3');

      /* WhatsApp click tracking */
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href*="wa.me"]');
        if (!link) return;
        gtag('event', 'whatsapp_click', {
          shortcode: link.getAttribute('data-wa-shortcode') || 'unknown',
          language: link.getAttribute('data-wa-lang') || document.documentElement.lang || 'unknown',
          page_path: window.location.pathname,
          page_title: document.title
        });
        /* Meta Lead with dnacpr_ eventID prefix (dedup key, cross-brand) */
        try {
          if (typeof window.fbq === 'function') {
            fbq('track', 'Lead', { eventID: 'dnacpr_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10) });
          }
        } catch (err) {}
      });
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "MedicalBusiness",
        "name": "DoctorNow AMD",
        "description": "香港上門簽署預設醫療指示（AMD）服務，由香港醫務委員會註冊西醫主理",
        "telephone": "+85263324599",
        "priceRange": "$$",
        "areaServed": { "@type": "City", "name": "Hong Kong" },
        "address": { "@type": "PostalAddress", "addressCountry": "HK" },
        "url": "https://dnacpr.hk",
        "medicalSpecialty": "CommunityHealth",
        "knowsAbout": { "@type": "Thing", "name": "Advance Medical Directive" }
      }
    </script>
    <title>{title}</title>
  </head>
  <body class="font-sans bg-surface text-on-surface antialiased tracking-[0.02em]">
    <Nav lang={lang} currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppCTA lang={lang} />
    <script>
      import { initScrollReveal } from '../lib/animations';
      document.addEventListener('DOMContentLoaded', () => {
        initScrollReveal();
      });
    </script>
    <!-- dnacpr beacon client (Option b 2026-09-02, Wilson GO A1) — all clicks carry short code. gclid path idempotent; organic path via /assign-organic client_ref. Fail-open. -->
    <script is:inline>
      (function() {
        var BEACON_URL = 'https://beacon.hkdrnow.com/';
        var CACHE_PREFIX = 'wa_beacon_code_';
        var ORG_KEY = 'wa_org_ref';

        function getGclid() {
          var m = location.search.match(/[?&]gclid=([^&#]+)/);
          return m ? decodeURIComponent(m[1]) : null;
        }
        function getBrand() {
          var h = location.hostname;
          if (/angelcare\./.test(h)) return 'angel-care';
          if (/dnacpr\./.test(h)) return 'amdcpr';
          if (/amdcpr/.test(h)) return 'amdcpr'; // pages.dev apex/preview hosts (2026-09-06 fix)
          return 'doctornow';
        }
        function getOrgRef() {
          try {
            var r = sessionStorage.getItem(ORG_KEY);
            if (r) return r;
            r = 'org_' + Date.now() + '_' + Math.random().toString(36).slice(2, 12);
            sessionStorage.setItem(ORG_KEY, r);
            return r;
          } catch (e) { return 'org_' + Date.now() + '_' + Math.random().toString(36).slice(2, 12); }
        }
        function readCache(key) {
          try {
            var raw = localStorage.getItem(CACHE_PREFIX + key);
            if (!raw) return null;
            var d = JSON.parse(raw);
            return d && d.code ? d.code : null;
          } catch (e) { return null; }
        }
        function writeCache(key, code) {
          try { localStorage.setItem(CACHE_PREFIX + key, JSON.stringify({ code: code, ts: Date.now() })); } catch (e) {}
        }
        function post(path, payload) {
          var attempt = function() {
            return new Promise(function(resolve) {
              var ctrl = new AbortController();
              var t = setTimeout(function() { ctrl.abort(); resolve(null); }, 2000);
              fetch(BEACON_URL + path, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
                keepalive: true,
                signal: ctrl.signal
              }).then(function(r) { return r.json(); }).then(function(d) {
                clearTimeout(t);
                resolve(d && d.code ? d : null);
              }).catch(function() { clearTimeout(t); resolve(null); });
            });
          };
          return attempt().then(function(c) { return c ? c : attempt(); }); // one retry
        }
        function fetchGclidCode(gclid, brand) { return post('', { gclid: gclid, ts: Date.now(), url: location.href, brand: brand }); }
        function fetchOrganicCode(clientRef, brand) { return post('assign-organic', { client_ref: clientRef, ts: Date.now(), url: location.href, brand: brand }); }
        function applyCode(code) {
          var links = document.querySelectorAll('a[href*="wa.me"], a[href*="api.whatsapp.com"], a[href*="whatsapp://"], a[data-dnh-href*="wa.me"], a[data-dnh-href*="api.whatsapp.com"]');
          var marker = '[' + code + ']';
          for (var j = 0; j < links.length; j++) {
            var a = links[j];
            try {
              var cur = a.href || a.getAttribute('data-dnh-href') || '';
              if (!cur) continue;
              var u = new URL(cur, location.origin);
              var t = u.searchParams.get('text') || '';
              if (t.indexOf(marker) !== -1) continue;
              // Option C: REPLACE legacy [AMD-S0x] preset token OR server-inlined placeholder
              // [AMD-09-NNN] with single combined [AMD-09-NNN] code from beacon running number.
              // Keep the preset body text → clean single-field WA pre-fill (no double token).
              var body = t.replace(/^\[(?:AMD-S\d{2}|AMD-\d{2}-[A-Za-z0-9]+)\]\s*/, '');
              u.searchParams.set('text', marker + ' ' + body.trim());
              var out = u.toString();
              if (a.hasAttribute('data-dnh-href')) a.setAttribute('data-dnh-href', out);
              if (a.href) a.href = out;
            } catch (e) { /* fail-open: leave this link */ }
          }
        }

        var brand = getBrand();
        var gclid = getGclid();
        var cacheKey = gclid && /^[A-Za-z0-9_-]{15,}$/.test(gclid) ? gclid : ('org:' + getOrgRef());
        var isGclid = gclid && /^[A-Za-z0-9_-]{15,}$/.test(gclid);
        var cached = readCache(cacheKey);

        function ready(fn) {
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
          else fn();
        }
        ready(function() { // runs after preset shortcode already in href (Astro server-side)
          if (cached) { applyCode(cached); return; }
          var req = isGclid ? fetchGclidCode(gclid, brand) : fetchOrganicCode(getOrgRef(), brand);
          req.then(function(d) {
            if (!d || !d.code) return; // fail-open: click proceeds with preset text only
            writeCache(cacheKey, d.code);
            applyCode(d.code);
          });
        });
      })();
    </script>
    <!-- dnacpr outbound rewrite (Step B 2026-09-02): tag doctornowhome.com links with utm_source=dnacpr, fail-open -->
    <script is:inline>
      (function() {
        // Defensive: dnacpr currently has no DNH outbound links; if any are added later
        // (content/CMS), auto-append utm_source=dnacpr so DNH can attribute the journey.
        function isOff() {
          try {
            if (window.__DNH_WA_OFF__ === 1 || window.__DNH_WA_OFF__ === true) return true;
            if (localStorage.getItem('dnh_wa_off') === '1') return true;
            if (/[?&]dnh_wa_off=1/.test(location.search)) return true;
          } catch (e) {}
          return false;
        }
        function rewrite() {
          try {
            if (isOff()) return;
            var links = document.querySelectorAll('a[href*="doctornowhome.com"]');
            var changed = 0;
            for (var j = 0; j < links.length; j++) {
              var a = links[j];
              try {
                var cur = a.href || '';
                if (!cur) continue;
                var u = new URL(cur, location.origin);
                if (u.searchParams.get('utm_source')) continue; // already tagged — never override
                u.searchParams.set('utm_source', 'dnacpr');
                if (!u.searchParams.get('utm_medium')) u.searchParams.set('utm_medium', 'content');
                if (!u.searchParams.get('utm_campaign')) u.searchParams.set('utm_campaign', 'referral');
                a.href = u.toString();
                changed++;
              } catch (e) { /* fail-open: leave this link */ }
            }
            try {
              if (changed > 0 && typeof gtag === 'function') {
                gtag('event', 'dnacpr_outbound_tag', { links: changed });
              }
            } catch (e) {}
          } catch (e) { /* fail-open */ }
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', rewrite);
        else rewrite();
      })();
    </script>
  </body>
</html>

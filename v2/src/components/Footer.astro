---
import { ui } from '../lib/i18n';

const { lang = 'zh' } = Astro.props;
const t = ui(lang).global;
const prefix = `/${lang}`;

const footerLinks = [
  { href: `${prefix}/what-is-amd`, label: t.whatIsAmd },
  { href: `${prefix}/amd-vs-dnacpr`, label: t.amdVsDnacpr },
  { href: `${prefix}/pricing`, label: t.pricingFull },
  { href: `${prefix}/faq`, label: t.faq },
  { href: `${prefix}/about/`, label: t.about },
];

const copyright = `© 2026 ${t.brand}. ${t.copyright}`;
---

<footer class="bg-primary text-white mt-8 rounded-t-[3rem]">
  <div class="max-w-7xl mx-auto px-6 md:px-12 pt-20 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <h4 class="font-bold text-xl mb-4">{t.brand}</h4>
        <p class="text-white/70 text-sm leading-relaxed">{t.tagline}</p>
      </div>
      <div>
        <h4 class="font-bold text-sm mb-4 uppercase tracking-widest text-secondary">{t.quickLinks}</h4>
        <ul class="space-y-2 text-sm text-white/70">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-white transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] no-underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="font-bold text-sm mb-4 uppercase tracking-widest text-secondary">{t.newsletterHeading}</h4>
        <form
            class="flex flex-col gap-3 mb-4"
            onsubmit={`event.preventDefault(); (async (form) => {
              const input = form.querySelector('input[type="email"]');
              try {
                const r = await fetch('/newsletter/subscribe', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email: input.value })
                });
                if (r.ok) { alert('${t.newsletterThanks}'); input.value = ''; }
                else { alert('Error. Please try again.'); }
              } catch { alert('Error. Please try again.'); }
            })(this)`}
          >
            <input
              type="email"
              placeholder={t.newsletterPlaceholder}
              required
              class="w-full px-4 py-2.5 rounded-full text-sm text-on-surface bg-white/90 border border-white/20 placeholder:text-on-surface-variant/60 focus:outline-none focus:ring-2 focus:ring-white/40 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]"
            />
            <button
              type="submit"
              class="bg-secondary w-full px-4 py-2.5 rounded-full text-sm font-bold no-underline transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] text-white hover:opacity-90"
            >
              {t.newsletterBtn}
            </button>
          </form>
        <p class="text-white/50 text-xs">{t.newsletterNote}</p>
      </div>
    </div>
    <div class="border-t border-white/20 mt-12 pt-8 text-center text-sm text-white/50">{copyright}</div>
  </div>
</footer>

---
import { waUrlWithShortcode, WA_SHORTCODES } from '../lib/site';
import { ui } from '../lib/i18n';

const { lang = 'zh' } = Astro.props;
const t = ui(lang).global;
const shortcode = 'AMD-S01';
const href = waUrlWithShortcode(shortcode, lang);

---
import { waUrlWithShortcode } from '../lib/site';
import { ui } from '../lib/i18n';

const { lang = 'zh', currentPath = '' } = Astro.props;
const t = ui(lang).global;
const isZh = lang === 'zh';
const prefix = `/${lang}`;

const links = [
  { href: `${prefix}/`, label: t.home, match: `^/${lang}/?$` },
  { href: `${prefix}/what-is-amd`, label: t.whatIsAmdNav, match: '/what-is-amd' },
  { href: `${prefix}/pricing`, label: t.pricing, match: '/pricing' },
  { href: `${prefix}/faq`, label: t.faq, match: '/faq' },
  { href: `${prefix}/blog`, label: t.blog, match: '/blog' },
  { href: `${prefix}/contact`, label: t.contact, match: '/contact' },
];

const otherLang = isZh ? 'en' : 'zh';
const otherLabel = isZh ? 'EN' : '中';
const navShortcode = 'AMD-S02';
const ctaUrl = waUrlWithShortcode(navShortcode, lang);

const pathWithoutLang = currentPath.replace(/^\/(zh|en)/, '') || '/';
const switchUrl = `/${otherLang}${pathWithoutLang === '/' ? '/' : pathWithoutLang}`;

function isActive(match: string): boolean {
  if (match.startsWith('^')) {
    return new RegExp(match).test(currentPath);
  }
  return currentPath.includes(match);
}
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/30">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-4 flex items-center justify-between">
    <a href={`${prefix}/`} class="flex items-center gap-2 no-underline">
      <span class="font-bold text-xl md:text-2xl text-primary tracking-wide">DoctorNow</span>
      <span class="text-xs text-on-surface-variant hidden sm:inline">{t.brandSub}</span>
    </a>
    <div class="hidden md:flex items-center gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'transition-all duration-700 text-sm font-medium no-underline',
            'ease-[cubic-bezier(0.32,0.72,0,1)]',
            isActive(link.match) ? 'text-primary' : 'text-on-surface-variant hover:text-primary',
          ]}
          aria-current={isActive(link.match) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href={switchUrl}
        class="text-xs font-bold px-3 py-1.5 rounded-full border border-outline-variant text-on-surface-variant hover:bg-surface-container transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] no-underline"
      >
        {otherLabel}
      </a>
      <a
        href={ctaUrl}
        target="_blank"
        rel="noopener"
        data-wa-shortcode={navShortcode}
        data-wa-lang={lang}
        class="bg-secondary text-white px-6 py-3 rounded-full text-sm font-bold no-underline transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:opacity-90 shadow-md"
      >
        {t.bookNow}
      </a>
    </div>
    <button id="mobile-menu-btn" class="md:hidden p-2" aria-label="Menu" type="button">
      <span class="hamburger-line block w-6 h-0.5 bg-on-surface mb-1.5 transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-on-surface mb-1.5 transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-on-surface transition-all duration-300 origin-center"></span>
    </button>
  </div>
  <div id="mobile-menu" class="hidden md:hidden px-6 pb-6 flex flex-col gap-3">
    {links.map((link) => (
      <a href={link.href} class="mobile-link text-on-surface font-medium no-underline py-2 transition-all duration-500">{link.label}</a>
    ))}
    <a href={switchUrl} class="mobile-link text-on-surface-variant font-medium no-underline py-2">{otherLabel}</a>
    <a
      href={ctaUrl}
      target="_blank"
      rel="noopener"
      data-wa-shortcode={navShortcode}
      data-wa-lang={lang}
      class="bg-secondary mobile-link text-white px-5 py-3 rounded-full text-base font-bold no-underline text-center mt-2 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:opacity-90"
    >
      {t.bookNow}
    </a>
  </div>
</nav>

<script>
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');

    if (!btn || !menu) return;

    const lines = btn.querySelectorAll('.hamburger-line');

    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');

      if (isOpen) {
        lines.forEach((line, i) => {
          line.style.transform = i === 0 ? 'translateY(-4px)' : i === 2 ? 'translateY(4px)' : '';
          line.style.opacity = '1';
        });
        menu.querySelectorAll('.mobile-link').forEach((link) => {
          link.style.opacity = '';
          link.style.transform = '';
        });
      } else {
        lines[0].style.transform = 'translateY(0) rotate(45deg)';
        lines[1].style.transform = 'rotate(-45deg)';
        lines[1].style.opacity = '0';
        lines[2].style.transform = 'translateY(0) rotate(-45deg)';

        menu.querySelectorAll('.mobile-link').forEach((link, i) => {
          link.style.opacity = '0';
          link.style.transform = 'translateY(0.75rem)';
          void link.offsetWidth;
          setTimeout(() => {
            link.style.opacity = '1';
            link.style.transform = 'translateY(0)';
          }, 100 + i * 80);
        });
      }
    });
  })();
</script>
